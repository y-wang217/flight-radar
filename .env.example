# From travelpayouts.com → Tools → API
TRAVELPAYOUTS_TOKEN=
# Optional affiliate marker appended to booking links
TRAVELPAYOUTS_MARKER=
# Any long random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=
# Injected by the Upstash for Redis integration on Vercel (`vercel env pull .env.local` locally)
KV_REST_API_URL=
KV_REST_API_TOKEN=
